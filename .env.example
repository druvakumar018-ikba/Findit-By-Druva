# ===================================================
# FindIt - Smart Lost and Found Platform Environment
# ===================================================

# Application Security Keys
# Set independent random values for production. Local development generates temporary keys if these are blank.
SECRET_KEY=
JWT_SECRET_KEY=

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=findit_db
DB_USER=root
DB_PASSWORD=your_mysql_password_here

# Direct Database URL (Optional; leave blank to use local MySQL/SQLite fallback)
# Example for MySQL: mysql+pymysql://root:password@localhost:3306/findit_db
# Example for SQLite: sqlite:///findit.db
DATABASE_URL=

# File Upload Settings
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=5242880  # 5MB in bytes

# Server Settings
FLASK_ENV=development
FLASK_DEBUG=True
PORT=5000
VITE_API_BASE_URL=http://localhost:5000/api

